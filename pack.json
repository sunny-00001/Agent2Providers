{
  "id": "agent2api-providers-extra",
  "name": "提供商增强（自建追加包）",
  "description": "自建的追加提供商包：只包含上游官方包尚未实现的家（当前为 MiniMax Code 国内版 / 国际版）。与官方包并存安装，不覆盖它；id 与官方包不同，因此不受「官方配套包最低版本」校验约束。",
  "license": "AGPL-3.0",
  "version": "0.1.0",
  "protocol": 1,
  "providers": [
    {
      "id": "minimax",
      "label": "MiniMax Code 国内版",
      "order": 0,
      "default_enabled": true
    },
    {
      "id": "minimax-intl",
      "label": "MiniMax Code 国际版",
      "order": 1,
      "default_enabled": true
    }
  ],
  "icons": "assets-extra",
  "entry": {
    "x86_64-pc-windows-msvc": "bin/agent2api-providers.exe",
    "x86_64-unknown-linux-gnu": "bin/agent2api-providers",
    "aarch64-unknown-linux-gnu": "bin/agent2api-providers",
    "x86_64-apple-darwin": "bin/agent2api-providers",
    "aarch64-apple-darwin": "bin/agent2api-providers"
  },
  "homepage": "https://github.com/sunny-00001/Agent2Providers"
}
